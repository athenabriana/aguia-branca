rules_version = '2';

// Regras Sprint 1 — acesso permitido para qualquer usuário autenticado.
// Sprint 2 endurecerá com regras por papel (lider/gestor/operador).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
