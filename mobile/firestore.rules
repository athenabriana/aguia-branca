rules_version = '2';

// Regras Sprint 1 — controle de acesso por papel (OPERADOR, GESTOR, LIDER).
// Sprint 2 endurecerá com custom claims (token.role) para evitar lookup por requisição.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function role() { return userDoc().role; }
    function isOperador() { return isAuth() && role() == 'OPERADOR'; }
    function isGestor()   { return isAuth() && role() == 'GESTOR'; }
    function isLider()    { return isAuth() && role() == 'LIDER'; }

    function affected() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    match /users/{uid} {
      // Todos autenticados leem (ranking, perfil de autores em ideias/projetos).
      allow read: if isAuth();

      // O próprio usuário cria seu doc no signup (caso futuro).
      allow create: if isAuth() && request.auth.uid == uid;

      // Próprio usuário pode atualizar seu doc — exceto o papel.
      // Gestores podem mexer apenas em points/badges (gamificação durante curadoria).
      allow update: if isAuth() && (
        (request.auth.uid == uid && !('role' in affected()))
        || (isGestor() && affected().hasOnly(['points', 'badges']))
      );

      allow delete: if false;
    }

    match /strategicGuidelines/{id} {
      allow read: if isAuth();
      allow create, update, delete: if isLider();
    }

    match /ideas/{id} {
      allow read: if isAuth();

      // Cria como autor, com status SUBMETIDA.
      allow create: if isAuth()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.status == 'SUBMETIDA';

      // Autor edita campos de conteúdo enquanto SUBMETIDA.
      // Gestor faz curadoria (ice, status, reviewer, comment, reviewedAt).
      allow update: if isAuth() && (
        (resource.data.authorId == request.auth.uid
          && resource.data.status == 'SUBMETIDA'
          && !('status' in affected())
          && !('reviewerId' in affected())
          && !('reviewComment' in affected())
          && !('authorId' in affected()))
        || isGestor()
      );

      // Autor exclui a própria ideia enquanto SUBMETIDA.
      allow delete: if isAuth()
        && resource.data.authorId == request.auth.uid
        && resource.data.status == 'SUBMETIDA';
    }

    match /projects/{pid} {
      allow read: if isAuth();
      allow create, update, delete: if isGestor();

      match /updates/{uid} {
        allow read: if isAuth();
        allow create: if isGestor();
        allow update, delete: if false;
      }
    }
  }
}
