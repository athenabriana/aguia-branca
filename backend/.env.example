# Copie para .env e preencha. NUNCA versione o .env.
# Chave JWT: mínimo 32 bytes. Gere com:  openssl rand -base64 48
JWT_KEY=

# Google Gemini (https://aistudio.google.com/) — opcional; sem chave, os insights de IA ficam desabilitados.
GEMINI_API_KEY=
# Modelo disponível no free tier da sua conta (ver ai.google.dev/gemini-api/docs/models)
GEMINI_MODEL=
# Teto diário de gerações (a cota gratuita é pequena e compartilhada por todos os líderes). Padrão: 100
GEMINI_DAILY_LIMIT=100
# Opcional (modelos Gemini 3): minimal | low | medium | high. Vazio = padrão do modelo.
GEMINI_THINKING_LEVEL=

# Popula usuários e dados de demonstração no startup (true|false)
SEED_ENABLED=true

# Expõe o Swagger UI em /swagger na API do compose (true|false)
SWAGGER_ENABLED=true
